# ============================================================
# sign_detector .gitignore
#   Git에 올리는 것: 모델(.slx/.sldd), 요구사항, 테스트, C++ 소스,
#                    학습된 NCNN 모델(cache/best_ncnn_model), 샘플 이미지(cache/dataset)
#   Git에 올리지 않는 것: 빌드·코드 생성 결과, 외부 라이브러리, 실행 결과
# ============================================================

# ---------- 프로젝트 전용 ----------
# Simulink 캐시 · 코드 생성 폴더 (프로젝트 설정의 SimulinkCacheFolder / CodeGenFolder, 빌드하면 다시 생김)
cache/sign_detector/

# Windows용 NCNN 사전 빌드 라이브러리 (외부 배포물, README의 "준비" 참고)
cache/ncnn_win/

# Process Advisor 실행 결과 (리포트, 로그, JUnit)
PA_Results/

# MATLAB 프로젝트 분석 캐시 (Digital Thread)
derived/

# 커버리지 리포트 (Test Manager가 다시 만듦)
slcov_output/

# ---------- MATLAB / Simulink 공통 ----------
# 자동 저장 · 백업
*.asv
*.m~
*.autosave
*.slx.r*
*.mdl.r*
*.sbproj.backup
*.sbproj.bak

# 컴파일 · 코드 생성 결과
*.mex*
*.p
*.slxc
slprj/
sccprj/
codegen/
*_ert_rtw/
*_grt_rtw/
*.elf

# 패키지 · 배포 파일
*.mlappinstall
*.mltbx
*.ctf
helpsearch*/

# 도구 캐시
.buildtool/
.MATLABDriveTag

# ---------- OS / 에디터 ----------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
